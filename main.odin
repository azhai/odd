package main

// ============================================================================
// main.odin — 程序入口（仅顶层编排）
//
// 职责：把 os.args 交给 app.run_main 分派，以其返回值作为进程退出码。
//       全部逻辑在 app 包（可测试）；本文件不做任何解析。
//
// 退出码约定（与 gx 一致）：
//   0 — 有输出/命中        1 — 无命中（grep 约定）
//   2 — 参数或运行期错误
// ============================================================================

import "core:os"
import "odd:app"

main :: proc() {
	os.exit(app.run_main(os.args))
}
